# Core OS — Modo Demo Web · variables de entorno
# Copia este archivo a .env y ajústalo.  (NUNCA subas tu .env al repo)

# Puerto del servidor (Render lo inyecta automáticamente).
PORT=3000

# Modo demo: true = datos simulados (útil en Vercel/serverless o sin Core OS).
# Ponlo a false en una VPS/Render para ver métricas REALES del host.
DEMO_MODE=true

# Ejecutar comandos reales en la terminal web (sólo con DEMO_MODE=false).
# La ejecución está limitada a una lista blanca de comandos de solo lectura.
ALLOW_TERMINAL=false

# Repositorio de GitHub para leer el historial de compilaciones (owner/repo).
GITHUB_REPO=core-os/core-os
GITHUB_BRANCH=main
# Token opcional: aumenta el rate limit y permite ver repos privados.
# GITHUB_TOKEN=ghp_xxx

# Metadatos mostrados en el panel.
CORE_OS_RELEASE=1.0.0
CORE_OS_BASE=Ubuntu 24.04 LTS (noble)
CORE_OS_REPOSITORY=https://github.com/core-os/core-os

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
