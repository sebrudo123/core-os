#cloud-config
# ---------------------------------------------------------------------------
# Core OS — Ubuntu Autoinstall (instalación desatendida vía cloud-init)
# Úsalo junto a meta-data en una partición/etiqueta "cidata" o con el
# instalador de Ubuntu cuando se active el modo autoinstall.
# ---------------------------------------------------------------------------
autoinstall:
  version: 1
  locale: es_ES.UTF-8
  keyboard:
    layout: es
  timezone: Europe/Madrid

  identity:
    hostname: core-os-node
    # Contraseña de ejemplo hasheada ("coreos"): CÁMBIALA en producción con
    #   mkpasswd -m sha-512
    password: "$6$rounds=4096$coreos01$2m6Tq1yQWxY9m4oYQ0oCeY6Zo3lRr0mQ7mS3H3nK8pQ2wV0xJ9tB4rL1cN5dE7fG8hI9jK0lM1nO2pQ3rS4tU5v"
    username: coreadmin

  ssh:
    install-server: true
    allow-pw: true

  network:
    version: 2
    ethernets:
      any:
        match:
          name: "e*"
        dhcp4: true

  storage:
    layout:
      name: lvm

  # Paquetes base. Los de Core OS se instalan en late-commands con los scripts.
  packages:
    - curl
    - git
    - htop
    - openssh-server

  late-commands:
    # Copia la personalización incluida en la ISO y ejecuta los scripts.
    - curtin in-target -- mkdir -p /opt/core-os
    - cp -a /cdrom/core-os-customization/* /target/opt/core-os/ 2>/dev/null || true
    - curtin in-target -- bash -c 'for s in /opt/core-os/scripts/0*.sh /opt/core-os/scripts/9*.sh; do bash "$s"; done'
    - curtin in-target -- systemctl enable ssh
    - curtin in-target -- bash -c 'echo "Core OS instalado correctamente" > /etc/core-os-installed'
