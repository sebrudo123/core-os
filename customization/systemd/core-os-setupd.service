# ===========================================================================
#  core-os-setupd.service — Servicio de instalación de Core OS.
#
#  Expone la API local del asistente (127.0.0.1:8765) y hace la instalación
#  REAL en el disco. Se ejecuta como root porque necesita particionar.
#
#  Solo actúa en el MEDIO EN VIVO: archiso crea /run/archiso al arrancar desde
#  la ISO. En el sistema instalado ese directorio no existe y el servicio no
#  hace nada (queda inerte, pero deshabilitado además por el instalador).
# ===========================================================================
[Unit]
Description=Core OS Setup (asistente de instalación)
After=network.target
Wants=network.target
ConditionPathExists=/run/archiso
ConditionPathExists=/usr/lib/core-os/setup/core-os-setup.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/core-os/setup/core-os-setup.py --server-only
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=core-os-setupd

[Install]
WantedBy=multi-user.target
