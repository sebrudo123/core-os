# ===========================================================================
#  Splash de arranque de Core OS (Plymouth)
#  Lenguaje de script de Plymouth: muestra el logo centrado y el nombre.
# ===========================================================================

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 30);

name_image = Image.Text("Core OS", 0.87, 0.91, 1.0);
name_sprite = Sprite(name_image);
name_sprite.SetX(Window.GetWidth() / 2 - name_image.GetWidth() / 2);
name_sprite.SetY(Window.GetHeight() / 2 + logo_image.GetHeight() / 2 + 10);

fun start_animation() {
  # Pulso suave del logo durante el arranque.
  logo_sprite.SetOpacity(1.0);
}

Plymouth.SetBootProgressFunction(start_animation);
