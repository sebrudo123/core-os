# Core OS — paquetes a instalar
# Formato: un nombre de paquete APT por línea. Los comentarios (#) se ignoran.
# Se instalan vía `scripts/10-install-packages.sh`.

# --- Base y utilidades de sistema ---
curl
wget
git
vim
nano
htop
btop
tree
unzip
zip
p7zip-full
jq
rsync
net-tools
dnsutils
traceroute
tmux

# --- Runtime del panel web (Modo Demo Web / administración) ---
ca-certificates
gnupg

# --- Diagnóstico y monitorización ---
sysstat
iotop
nethogs
lm-sensors
smartmontools
gdisk
nvme-cli
fio

# --- Contenedores y virtualización ---
docker.io
docker-compose-v2
qemu-guest-agent

# --- Red y seguridad ---
ufw
openssh-server
iptables
fail2ban
nmap
netcat-openbsd

# --- Escritorio GNOME ---
gnome-shell-extension-manager
gnome-tweaks
gnome-disk-utility
gnome-system-monitor
file-roller
gufw

# --- Navegación y ofimática ---
# NOTA: en Ubuntu 24.04 `firefox` y `thunderbird` son paquetes de transición a
# snap; como Core OS usa APT + Flatpak (sin snapd), no se instalan aquí.
# Para el navegador se puede usar Flatpak (ver scripts/40) o el .deb de Mozilla.
libreoffice-calc
libreoffice-writer

# --- Fuentes e idiomas ---
fonts-firacode
fonts-noto
fonts-noto-color-emoji
language-pack-es
language-pack-es-base

# --- Escritorio propio de Core OS (identidad tipo Windows 11) ---
# Arranque, splash e identidad visual
plymouth
plymouth-themes
desktop-file-utils
xdg-utils
zenity
dconf-cli
libglib2.0-bin
# Tienda de aplicaciones (estilo Microsoft Store) con Flatpak
flatpak
# NOTA: en Ubuntu 24.04 `gnome-software` (y `gnome-software-plugin-flatpak`)
# son paquetes de transición al snap, y por tanto arrastran `snapd` (que Core OS
# no usa). Se omiten: para instalar apps se usa Flatpak directamente
# (`flatpak install flathub ...`) y el "gestor de software" de Core OS.
# gnome-software
# gnome-software-plugin-flatpak

# --- Asistente de instalación propio (estilo Windows 11) ---
# Interfaz del instalador: GTK + WebKit2GTK (HTML/CSS/JS) y utilidades de disco.
python3-gi
gir1.2-gtk-3.0
gir1.2-webkit2-4.1
parted
dosfstools

# --- Core OS propio (paquetes .deb locales, ver scripts/40) ---
# core-os-admin
# core-os-branding
